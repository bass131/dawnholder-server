<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <FormatterSdkDirectory>$(MSBuildSDKsPath)/../DotnetTools/dotnet-format</FormatterSdkDirectory>
  </PropertyGroup>

  <!-- Same test packages and versions as GameServer.Tests; no new dependency source. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Fixtures are inspected data, never part of this project's Compile set. -->
    <Compile Remove="Fixtures/**" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Parse options must come from the Workspace shipped with the pinned SDK formatter. -->
  <ItemGroup>
    <ProjectReference Include="../Formatting/Formatting.csproj" />
    <Reference Include="$(FormatterSdkDirectory)/*.dll" Exclude="$(FormatterSdkDirectory)/dotnet-format.dll;$(FormatterSdkDirectory)/Microsoft.Build*.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Locator">
      <HintPath>$(FormatterSdkDirectory)/BuildHost-netcore/Microsoft.Build.Locator.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
