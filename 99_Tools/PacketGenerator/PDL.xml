<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dawnholder Protocol Definition Language (단일 소스).

    M1 Phase 06: Ping/Pong 시작.
    M2 Phase 03: S_EnterMap/S_LeaveMap (접속 핸드셰이크) 추가.
    M2 Phase 04: C_MoveIntent/S_Snapshot (이동) 추가.

    명명 규칙 (Program.cs L93 참조):
      - C_Xxx = Client → Server (서버 PacketManager에 dispatch 등록)
      - S_Xxx = Server → Client (클라 PacketManager에 dispatch 등록)

    PacketID는 추가 순서대로 1부터 자동 부여 (Program.cs L89 ++packetID).
    은퇴한 패킷 제거 시 ID 재할당 주의 — 헌법 #2(Protocol is Sacred):
    "은퇴한 ID는 절대 재사용 금지". 패킷 추가는 *맨 아래에만*.
-->
<PDL>
    <packet name="C_Ping">
        <long name="clientTimestampMs"/>
    </packet>

    <packet name="S_Pong">
        <long name="clientTimestampMs"/>
        <long name="serverTimestampMs"/>
    </packet>

    <!-- Phase 03 (M2): 접속 핸드셰이크. 서버가 정한 spawn 좌표로 클라 캐릭터 배치. -->
    <packet name="S_EnterMap">
        <int name="entityId"/>
        <float name="spawnX"/>
        <float name="spawnY"/>
    </packet>

    <!-- 본 Phase는 본인 1명만 — 자기 disconnect는 OnDisconnected로 처리되므로
         이 패킷은 사실상 미사용. 향후 다른 플레이어 정리용 골격으로 박음. -->
    <packet name="S_LeaveMap">
        <int name="entityId"/>
    </packet>

    <!-- Phase 04 (M2): C_MoveIntent — 클라가 보내는 *의도*. 좌표 X. 헌법 #3 (Trust Boundary).
         clientTick은 Phase 06 replay 대비.

         Phase 07 (M2) [Protocol.Version v1→v2]: sbyte inputX → byte input 비트필드로 교체.
         D2 결정 (현업 정석 — Quake/Source/한국 MMORPG): 입력 종류 늘면 패킷 비대 차단 + 1 byte에 8 입력 표현.

         **byte input 비트 레이아웃** (Shared.GameData.InputBits 단일 출처 — 본 주석은 살아있는 문서):
           bit 0~1: inputX (00=-1 / 01=0 / 10=+1 / 11=reserved/invalid)
           bit 2:   jumpPressed (edge — 클라가 1tick만 true 송신, D4 결정)
           bit 3~7: reserved (미래 — 공격/방어/스킬 등)

         InputBits.cs와 본 주석의 비트표는 *반드시 일치*. 한쪽 변경 시 다른쪽 동반 갱신 (Codex 함정 #3). -->
    <packet name="C_MoveIntent">
        <byte name="input"/>
        <uint name="clientTick"/>
    </packet>

    <!-- Phase 04 (M2): S_Snapshot — 서버가 권위 좌표를 매 SnapshotTickInterval(=2)마다 브로드캐스트.
         lastAckedClientTick = 서버가 "여기까지 처리했다" ack 값. Phase 06부터 클라 replay reconcile의 기준점.
         타입은 uint (Phase 06에서 int→uint 정합, tick은 비음수 카운터).

         Phase 06 (M2): clientTick / lastAckedClientTick uint 정합 — int 음수 사고 차단.
         Phase 07 (M2) [Protocol.Version v1→v2]: vx, vy 추가 — prediction reconcile 시 velocity 동기화.
         클라가 점프 후 공중에서 reconcile 발생하면 서버 권위 vy까지 받아야 자연 정정 (Y축 prediction 정합).
         M4.3 Phase 08a [Protocol.Version v7→v8]: animState 추가 — 플레이어 시각 애니 상태 (RemotePlayer 렌더용). -->
    <packet name="S_Snapshot">
        <int name="entityId"/>
        <float name="x"/>
        <float name="y"/>
        <float name="vx"/>
        <float name="vy"/>
        <int name="serverTick"/>
        <uint name="lastAckedClientTick"/>
        <byte name="animState"/>
    </packet>

    <!-- Phase 02 (M3): Application-layer handshake. 헌법 #2 "Protocol is Sacred" 가짜 약속 1번째 봉합.
         98_Shared/CLAUDE.md "Protocol 버전 핸드셰이크" 섹션에 "코드 미구현" 박혀있던 상태 → 본 패킷 2개로 봉합.

         **흐름**:
           1. 클라 접속 → 첫 패킷으로 C_Handshake { clientVersion } 전송 (다른 패킷 보내기 전).
           2. 서버 GameSession이 first-packet 강제 — handshake 아니면 거절 + 즉시 Disconnect.
           3. clientVersion == ProtocolVersion.Current → S_HandshakeResult(ok=true) 회신 + 게임 진입 (S_EnterMap).
           4. mismatch → S_HandshakeResult(ok=false, reason=...) 회신 + 즉시 Disconnect (헌법 #3 정합 — timeout 안 기다림).

         **응급 모드 결정** (5/20 데모): clientVersion == serverVersion `==` 비교만. 호환 가능 minor version 호환표는 본 마감 시.

         **PacketGenerator bool/string fix 의존**: 본 패킷이 도구 결함의 첫 실수요자 (M3 Phase 02 묶음 fix).
         CHANGELOG 2026-05-18 (M3 Phase 02) 박힘. -->
    <packet name="C_Handshake">
        <ushort name="clientVersion"/>
    </packet>

    <packet name="S_HandshakeResult">
        <bool name="ok"/>
        <ushort name="serverVersion"/>
        <string name="reason"/>
    </packet>

    <!-- Phase 04 (M3): Player join broadcast. multi-player 환경에서 *기존 플레이어들에게* 신규 entity 알림.
         **수신측 동작 (Phase 05 클라 remote entity)**: entityId 일치하는 remote entity가 없으면 spawn,
         있으면 무시 (idempotent — initial roster 재전송 안전).
         **자기 자신은 받지 않음** — sender의 OnConnected 흐름에서 자기 외 모든 세션에 broadcast.
         spawnX/Y는 *서버가 정한* 좌표 (헌법 #1 Server Authority).
         M4.5 Phase 04 [Protocol.Version v8→v9]: characterClass byte 맨 끝 append (원격 플레이어 직업 표시용).
         서버 권위 값. Knight=0 / Mage=1. -->
    <packet name="S_PlayerJoin">
        <int name="entityId"/>
        <float name="spawnX"/>
        <float name="spawnY"/>
        <byte name="characterClass"/>
    </packet>

    <!-- Phase 04 (M3): Player leave broadcast. multi-player 환경에서 *남은 플레이어들에게* 이탈 entity 알림.
         **수신측 동작**: entityId 일치하는 remote entity despawn. idempotent.
         **자기 자신은 받지 않음** — leaver의 OnDisconnected 흐름에서 자기 외 모든 세션에 broadcast.
         S_LeaveMap과 구별: S_LeaveMap = "내가 떠난다" 통보(현재 미사용), S_PlayerLeave = "다른 플레이어가 떠났다" broadcast. -->
    <packet name="S_PlayerLeave">
        <int name="entityId"/>
    </packet>

    <!-- Phase 06 (M3): 응급 전투 — 클라가 서버에 공격 의도 전송. 헌법 #1 (Server Authority) 정합 표준 패턴.
         클라 = "I attempted attack on target Y" / 서버 = hit/miss/damage/HP 권위 판정 후 S_HitResult 회신.

         ⚠️ **attacker 필드 *없음* — 헌법 #3 (Trust Boundary) 정합**.
         서버가 `GameSession._entityId`에서 attacker 강제 → 패킷에 attacker 박으면 다른 entityId 도용 가능.
         Codex β 사전 검증 HIGH #2 봉합 (direction/facing/ray 모델은 응급 범위 초과로 폐기,
         target id 직접 지정 방식으로 단순화).

         M4.1 Phase 06 lag compensation: 클라가 본 공격을 인지한 시점의 lastReceivedServerTick.
         서버가 이 tick으로 attacker 위치를 rewind. -->
    <packet name="C_Attack">
        <int name="targetEntityId"/>
        <int name="attackerClientTick"/>
    </packet>

    <!-- Phase 06 (M3): Enemy spawn 알림. Codex β 사전 검증 HIGH #1 봉합 — 본 패킷 누락 시 클라가
         target id를 모름(공격 패킷만 박으면 end-to-end 데모 막힘).
         **수신측 동작**: entityId 일치하는 remote enemy entity가 없으면 spawn, 있으면 무시(idempotent).
         **다발 전송 패턴** (Phase 04 S_PlayerJoin 정합): 신규 client EnterGameWorld 시 active enemy roster
         (`GameMap._enemies` 전체)를 다발 전송 → 신규 client는 한 번에 전원 위치 파악.
         entityKind = EnemyKind enum의 byte cast (0=Normal, 1=Boss). 클라 측 디코드 책임. -->
    <packet name="S_EntitySpawn">
        <int name="entityId"/>
        <byte name="entityKind"/>
        <float name="x"/>
        <float name="y"/>
        <int name="currentHp"/>
        <int name="maxHp"/>
    </packet>

    <!-- Phase 06 (M3): Hit 결과 broadcast. Codex β 사전 검증 MEDIUM #3 봉합 — HpUpdate 통합.
         damage text(클라 시각 효과) + HP bar 갱신을 *한 패킷*으로 동시 처리 → broadcast 비용 1배.
         통합 vs 분리 trade-off: 분리는 UI 이벤트 ↔ 상태 갱신 직무 분리지만, 응급은 통합 우선
         (현재 정의는 Phase 06 정의 박힘, 본 마감 분리 검토).
         서버가 전원에게 broadcast (attacker 자기도 포함 — local damage text 렌더 정합). -->
    <packet name="S_HitResult">
        <int name="attackerEntityId"/>
        <int name="targetEntityId"/>
        <int name="damage"/>
        <int name="currentHp"/>
        <int name="maxHp"/>
        <byte name="hitEffect"/>  <!-- M4.8 [v10→v11]: 클라 VFX 분기. 0=기본/근접, 1=투사체 도착, 2=낙뢰.
             평타(투사체)·썬더볼트(낙뢰)가 같은 S_HitResult로 도착 데미지를 운반(PDL list 미지원 회피) —
             hitEffect로 도착 연출 종류만 구분. append-only(끝에 byte 1개, 기존 필드 오프셋 불변). -->
    </packet>

    <!-- Phase 06 (M3): Entity 사망 broadcast. idempotent 약속 — 서버 `IsDead` flag로 1회만 발사 보장.
         **수신측 동작**: entityId 일치하는 entity despawn (player/enemy 공통). 두 번 받아도 안전.
         Phase 07 보스 사망은 본 패킷 + S_StageClear *별개* 이벤트 (Codex 권장 — 통합 X).
         death broadcast → 클라가 엔티티 제거 → 다음 spawn 패킷 안 옴 (서버 map에서도 제거). -->
    <packet name="S_EntityDeath">
        <int name="entityId"/>
    </packet>

    <!-- Phase 07 (M3): Stage Clear broadcast. 보스(EnemyKind.Boss) HP 0 시점 1회 broadcast.
         서버 `_stageCleared` flag로 중복 방지 (death broadcast와 별 trigger).
         클라 = UI 표시만 (헌법 #1 권위) — 보스 죽음 판정 X, 본 패킷 수신 시점 = stage clear 권위 신호.

         **death (S_EntityDeath, ID 14)와 *별 패킷* 분리 결정** (Codex 권장):
           - S_EntityDeath = entity lifecycle (player/enemy 공통, idempotent despawn)
           - S_StageClear  = game event (보스 한정, UI/씬 전환 trigger)
           직무 분리 + S_EntityDeath.isStageBoss 플래그 통합은 미래 보스 종류 확장 시 폐쇄 패킷화.

         **broadcast 순서**: 같은 tick 안에서 S_EntityDeath → S_StageClear (lifecycle 먼저 / game event 두 번째).
         클라 측은 entity despawn 처리 후 stage clear UI 띄우면 자연스러운 흐름.

         **중복 방지**: 서버 `GameMap._stageCleared` flag로 1회 보장. HP 0 후 추가 attack 도착해도
         (a) target이 이미 _enemies.Remove로 사라져 step 2 silent drop (b) `_stageCleared=true`면 본 broadcast 미진입. -->
    <packet name="S_StageClear">
        <int name="bossEntityId"/>
    </packet>

    <!-- Phase 03 (M3.8): 캐릭터 선택. 클라가 *선택 의도만* 전송 (헌법 #1 Server Authority 정합).
         서버가 characterClass 검증 + PlayerStats 박음 (전사/원거리 default stats 매핑).

         **헌법 #3 (Trust Boundary)**: characterClass 범위 검증 0/1만 허용. 2/255 등은 silent drop
         (cheat-flag 후보, M4.2 cheat-flag 도입 시 기록). disconnect X (cheat 인지 X).

         **중복 선택 차단**: GameSession.HasSelectedClass=true 시 silent drop (옛 stats 유지).

         **ProtocolVersion bump 3→4 동반** — backward compatible append-only지만 옛 빌드 클라
         호환성 차단 위해 bump (M3 Phase 02 handshake 정합 패턴). -->
    <packet name="C_CharacterSelect">
        <byte name="characterClass"/>
    </packet>

    <!-- Phase 02 (M4.2): 맵 전환 패킷 2종. ProtocolVersion 5→6 bump 동반.

         C_EnterPortal — 클라가 portal 진입 *의도만* 전송 (헌법 #1 Server Authority 정합).
         portalId만 포함. 좌표/목적지는 X — 서버가 portalId로 portal 정의를 조회해 목적지 결정.
         **헌법 #3 (Trust Boundary)**: portalId는 untrusted. Phase 03에서 범위/근접 검증 추가.
         패킷 필드에 attacker/destination을 클라가 결정하면 teleport 핵 가능 (C_Attack 패턴 정합). -->
    <packet name="C_EnterPortal">
        <int name="portalId"/>
    </packet>

    <!-- S_MapTransition — 서버가 맵 전환 권위 통보. 목적지 맵 + spawn 좌표.
         **entityId 필드 없음** (ADR-026: entity id 전역 풀 — 맵 이동 시 id 유지, 클라가 기존 id 보유).
         destMapId = MapId enum의 byte cast (0=Town, 1=HuntingGround, 2=BossRoom 등).
         spawnX/spawnY = 서버가 정한 목적지 spawn 좌표 (헌법 #1 Server Authority).
         클라 수신 시 현재 맵 entity 전체 정리 → destMapId 맵으로 씬 전환 → spawnX/Y에 player 배치. -->
    <packet name="S_MapTransition">
        <byte name="destMapId"/>
        <float name="spawnX"/>
        <float name="spawnY"/>
    </packet>

    <!-- M4.3 Phase 07 (enemy AI): 움직이는 적의 위치/상태 주기적 브로드캐스트.
         S_EntitySpawn(ID 12)이 최초 1회 spawn 알림이라면, 본 패킷은 매 틱(또는 N틱 간격)마다
         서버가 적 위치·FSM 상태를 갱신해 클라에 전송하는 *업데이트* 패킷.

         **state(byte) 의미** — server Phase에서 정의될 EnemyState enum의 byte cast:
           0 = Idle    (대기 — spawn 직후, 플레이어 없음)
           1 = Patrol  (순찰 — PatrolRange 내 왕복)
           2 = Chase   (추격 — AggroRange 내 플레이어 감지)
         클라 측 디코드 책임 (S_EntitySpawn.entityKind 패턴 정합).

         **ProtocolVersion 8 동반**: M4.3 Phase 08a bump.
         S_EnemyAttack은 v9 신설 (M4.5 Phase 04 — 옛 Phase 09가 v8 묶음에서 이월되며 깨진 약속, 본 묶음에서 정정).
         M4.3 Phase 08a: animState 추가 — 기존 state(AI: Patrol/Chase 시각구분용) 뒤에 append.
         클라(08b)는 animState로 모션 결정, state로 선택적 AI 상태 강조. -->
    <packet name="S_EntityState">
        <int name="entityId"/>
        <float name="x"/>
        <float name="y"/>
        <byte name="state"/>
        <byte name="animState"/>
    </packet>

    <!-- M4.5 Phase 04 [Protocol.Version v8→v9]: 적→플레이어 권위 데미지 통지.
         telegraph 예고는 S_EntityState animState 채널, 본 패킷은 히트 확정 통지.
         **attackerId**: 보스 entityId (서버 권위, 클라가 결정 X).
         **targetId**: 피격 플레이어 entityId.
         **damage**: 확정 데미지 값 (양수).
         **targetCurrentHp**: 피격 후 플레이어 HP. 음수 가능(사망 처리용) — 클라는 max(0, value)로 표시.
         **attackPattern**: 클라 이펙트 분기 힌트. 0=페이즈1 기본, 1=페이즈2 강화.
         수신측은 S_EntityDeath 별도 broadcast로 사망 lifecycle 처리 (본 패킷 = 데미지 통지만). -->
    <packet name="S_EnemyAttack">
        <int name="attackerId"/>
        <int name="targetId"/>
        <int name="damage"/>
        <int name="targetCurrentHp"/>
        <byte name="attackPattern"/>
    </packet>

    <!-- M4.7 Phase 01 [Protocol.Version v9→v10]: 플레이어 HP 권위 동기화 (전용 이벤트).
         S_Snapshot에 HP가 없어 사망/부활 HP를 클라가 PlayerStats.MaxHp 표시 미러로 때우던 것(M4.5 임시)을 교체.
         on-change 송신(진입/피격/부활) — 고빈도 snapshot 비대화 회피(헌법 #5), TCP 신뢰전송이라 손실 약점 무효.
         **entityId**: 어느 플레이어 HP인가. 이번엔 본인에게만 1:1 송신(HUD)이나, 미래 원격/파티 HP 바 확장 키로 미리 박음
                       — 미래 전원 broadcast 승격 시 패킷 모양 불변 → 추가 bump 불필요.
         **currentHp**: 서버 권위 현재 HP. 0 floor로 송신(표시 전용 — 사망 lifecycle은 별도 채널).
         **maxHp**: 서버 권위 maxHp — 클라 PlayerStats.ForClass 추론 제거. -->
    <packet name="S_PlayerHp">
        <int name="entityId"/>
        <int name="currentHp"/>
        <int name="maxHp"/>
    </packet>

    <!-- M4.7 Phase 01 [Protocol.Version v9→v10]: 원격 플레이어 공격 "발동 순간" 이벤트.
         원격 공격은 S_Snapshot animState=Attack(지속상태 미러)로만 보여 투사체 같은 순간 이벤트 표현 불가였음.
         서버는 rate-limit/rewind 통과한 유효 시도 시 broadcast(attacker 제외) — 허공 스윙 포함(스윙↔명중 분리).
         **attackerEntityId**: 공격 발동 플레이어 (서버 권위, 클라 도용 X).
         **attackType**: 연출 종류. 0=Melee(Knight 근접 스윙), 1=Ranged(Mage 투사체). class 미러 아닌 연출 분기(미래 스킬 확장).
         **targetEntityId**: 투사체 호밍/스윙 대상. 0=허공(타겟 없음).
         **facing**: 0=left, 1=right. target 소실 race·허공 스윙 시 폴백 방향. -->
    <packet name="S_PlayerAttack">
        <int name="attackerEntityId"/>
        <byte name="attackType"/>
        <int name="targetEntityId"/>
        <byte name="facing"/>
    </packet>

    <!-- M4.8 Phase 01 [Protocol.Version v10→v11]: 평타(Mage) 단일 호밍 투사체 *발사 연출* 통보.
         서버가 명중을 즉발 확정(lag-comp)한 뒤 broadcast — 클라 선예측 스폰 폐지("그림은 맞았는데 데미지0" 방지).
         데미지는 본 패킷이 아니라 도착 틱의 S_HitResult(hitEffect=1)로 옴(발사↔도착 분리 = M4.7 스윙↔명중 분리 정신).
         **attackerEntityId**: 발사자(서버 권위). **targetEntityId**: 호밍 대상. **projectileType**: 0=Mage 평타(미래 분기).
         **travelTicks**: 발사~도착 틱(거리 비례). 클라 투사체 비행시간 + 적 freeze 지속과 동일. -->
    <packet name="S_ProjectileLaunch">
        <int name="attackerEntityId"/>
        <int name="targetEntityId"/>
        <byte name="projectileType"/>
        <int name="travelTicks"/>
    </packet>

    <!-- M4.8 Phase 01 [Protocol.Version v10→v11]: 스킬 발동 요청(클라→서버). 평타(C_Attack)와 별개 채널.
         **헌법 #3 (Trust Boundary)**: skillId는 untrusted — 서버가 범위 검증(1=Thunderbolt만, 그 외 silent drop=cheat 후보)
         + 쿨다운 서버 권위 판정. 패킷에 데미지/타겟 박지 않음 — 서버가 공격자 위치 기준 박스 스캔으로 대상 확정.
         **attackerClientTick**: lag-comp rewind 기준(C_Attack 패턴 정합). -->
    <packet name="C_SkillUse">
        <byte name="skillId"/>
        <int name="attackerClientTick"/>
    </packet>

    <!-- M4.8 Phase 01 [Protocol.Version v10→v11]: 스킬 *캐스팅 연출* 통보(서버→클라). **타격 목록 없음**.
         PDL이 가변 길이 list를 지원하지 않아(전 패킷 고정 필드), 썬더볼트 타격 적은 발동 시 박스 스캔으로 확정 후
         각 적을 개별 DeferredDamage 큐에 넣고 도착 시 *적마다* S_HitResult(hitEffect=2=낙뢰)로 보낸다.
         본 패킷은 캐스터의 시전 모션/사운드 트리거만 — 개별 낙뢰 VFX·데미지는 S_HitResult가 담당.
         **casterEntityId**: 시전자(서버 권위). **skillId**: 1=Thunderbolt. **strikeDelayTicks**: 발동~낙뢰 틱(freeze 지속).
         **facing**: 0=left, 1=right(박스 전방 방향). -->
    <packet name="S_SkillCast">
        <int name="casterEntityId"/>
        <byte name="skillId"/>
        <int name="strikeDelayTicks"/>
        <byte name="facing"/>
    </packet>
</PDL>
