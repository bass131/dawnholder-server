<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dawnholder Protocol Definition Language (단일 소스).

    M1 Phase 06: Ping/Pong 시작.
    M2 Phase 03: S_EnterMap/S_LeaveMap (접속 핸드셰이크) 추가.
    M2 Phase 04: C_MoveIntent/S_Snapshot (이동) 추가.

    명명 규칙 (Program.cs L93 참조):
      - C_Xxx = Client → Server (서버 PacketManager에 dispatch 등록)
      - S_Xxx = Server → Client (클라 PacketManager에 dispatch 등록)

    PacketID는 추가 순서대로 1부터 자동 부여 (Program.cs L89 ++packetID).
    은퇴한 패킷 제거 시 ID 재할당 주의 — 헌법 #2(Protocol is Sacred):
    "은퇴한 ID는 절대 재사용 금지". 패킷 추가는 *맨 아래에만*.
-->
<PDL>
    <packet name="C_Ping">
        <long name="clientTimestampMs"/>
    </packet>

    <packet name="S_Pong">
        <long name="clientTimestampMs"/>
        <long name="serverTimestampMs"/>
    </packet>

    <!-- Phase 03 (M2): 접속 핸드셰이크. 서버가 정한 spawn 좌표로 클라 캐릭터 배치. -->
    <packet name="S_EnterMap">
        <int name="entityId"/>
        <float name="spawnX"/>
        <float name="spawnY"/>
    </packet>

    <!-- 본 Phase는 본인 1명만 — 자기 disconnect는 OnDisconnected로 처리되므로
         이 패킷은 사실상 미사용. 향후 다른 플레이어 정리용 골격으로 박음. -->
    <packet name="S_LeaveMap">
        <int name="entityId"/>
    </packet>

    <!-- Phase 04 (M2): C_MoveIntent — 클라가 보내는 *의도*. 좌표 X. 헌법 #3 (Trust Boundary).
         clientTick은 Phase 06 replay 대비.

         Phase 07 (M2) [Protocol.Version v1→v2]: sbyte inputX → byte input 비트필드로 교체.
         D2 결정 (현업 정석 — Quake/Source/한국 MMORPG): 입력 종류 늘면 패킷 비대 차단 + 1 byte에 8 입력 표현.

         **byte input 비트 레이아웃** (Shared.GameData.InputBits 단일 출처 — 본 주석은 살아있는 문서):
           bit 0~1: inputX (00=-1 / 01=0 / 10=+1 / 11=reserved/invalid)
           bit 2:   jumpPressed (edge — 클라가 1tick만 true 송신, D4 결정)
           bit 3~7: reserved (미래 — 공격/방어/스킬 등)

         InputBits.cs와 본 주석의 비트표는 *반드시 일치*. 한쪽 변경 시 다른쪽 동반 갱신 (Codex 함정 #3). -->
    <packet name="C_MoveIntent">
        <byte name="input"/>
        <uint name="clientTick"/>
    </packet>

    <!-- Phase 04 (M2): S_Snapshot — 서버가 권위 좌표를 매 SnapshotTickInterval(=5)마다 브로드캐스트.
         lastAckedClientTick = 서버가 "여기까지 처리했다" ack 값. Phase 06부터 클라 replay reconcile의 기준점.
         타입은 uint (Phase 06에서 int→uint 정합, tick은 비음수 카운터).

         Phase 06 (M2): clientTick / lastAckedClientTick uint 정합 — int 음수 사고 차단.
         Phase 07 (M2) [Protocol.Version v1→v2]: vx, vy 추가 — prediction reconcile 시 velocity 동기화.
         클라가 점프 후 공중에서 reconcile 발생하면 서버 권위 vy까지 받아야 자연 정정 (Y축 prediction 정합). -->
    <packet name="S_Snapshot">
        <int name="entityId"/>
        <float name="x"/>
        <float name="y"/>
        <float name="vx"/>
        <float name="vy"/>
        <int name="serverTick"/>
        <uint name="lastAckedClientTick"/>
    </packet>

    <!-- Phase 02 (M3): Application-layer handshake. 헌법 #2 "Protocol is Sacred" 가짜 약속 1번째 봉합.
         98_Shared/CLAUDE.md "Protocol 버전 핸드셰이크" 섹션에 "코드 미구현" 박혀있던 상태 → 본 패킷 2개로 봉합.

         **흐름**:
           1. 클라 접속 → 첫 패킷으로 C_Handshake { clientVersion } 전송 (다른 패킷 보내기 전).
           2. 서버 GameSession이 first-packet 강제 — handshake 아니면 거절 + 즉시 Disconnect.
           3. clientVersion == ProtocolVersion.Current → S_HandshakeResult(ok=true) 회신 + 게임 진입 (S_EnterMap).
           4. mismatch → S_HandshakeResult(ok=false, reason=...) 회신 + 즉시 Disconnect (헌법 #3 정합 — timeout 안 기다림).

         **응급 모드 결정** (5/20 데모): clientVersion == serverVersion `==` 비교만. 호환 가능 minor version 호환표는 본 마감 시.

         **PacketGenerator bool/string fix 의존**: 본 패킷이 도구 결함의 첫 실수요자 (M3 Phase 02 묶음 fix).
         CHANGELOG 2026-05-18 (M3 Phase 02) 박힘. -->
    <packet name="C_Handshake">
        <ushort name="clientVersion"/>
    </packet>

    <packet name="S_HandshakeResult">
        <bool name="ok"/>
        <ushort name="serverVersion"/>
        <string name="reason"/>
    </packet>

    <!-- Phase 04 (M3): Player join broadcast. multi-player 환경에서 *기존 플레이어들에게* 신규 entity 알림.
         **수신측 동작 (Phase 05 클라 remote entity)**: entityId 일치하는 remote entity가 없으면 spawn,
         있으면 무시 (idempotent — initial roster 재전송 안전).
         **자기 자신은 받지 않음** — sender의 OnConnected 흐름에서 자기 외 모든 세션에 broadcast.
         spawnX/Y는 *서버가 정한* 좌표 (헌법 #1 Server Authority). -->
    <packet name="S_PlayerJoin">
        <int name="entityId"/>
        <float name="spawnX"/>
        <float name="spawnY"/>
    </packet>

    <!-- Phase 04 (M3): Player leave broadcast. multi-player 환경에서 *남은 플레이어들에게* 이탈 entity 알림.
         **수신측 동작**: entityId 일치하는 remote entity despawn. idempotent.
         **자기 자신은 받지 않음** — leaver의 OnDisconnected 흐름에서 자기 외 모든 세션에 broadcast.
         S_LeaveMap과 구별: S_LeaveMap = "내가 떠난다" 통보(현재 미사용), S_PlayerLeave = "다른 플레이어가 떠났다" broadcast. -->
    <packet name="S_PlayerLeave">
        <int name="entityId"/>
    </packet>

    <!-- Phase 06 (M3): 응급 전투 — 클라가 서버에 공격 의도 전송. 헌법 #1 (Server Authority) 정합 표준 패턴.
         클라 = "I attempted attack on target Y" / 서버 = hit/miss/damage/HP 권위 판정 후 S_HitResult 회신.

         ⚠️ **attacker 필드 *없음* — 헌법 #3 (Trust Boundary) 정합**.
         서버가 `GameSession._entityId`에서 attacker 강제 → 패킷에 attacker 박으면 다른 entityId 도용 가능.
         Codex β 사전 검증 HIGH #2 봉합 (direction/facing/ray 모델은 응급 범위 초과로 폐기,
         target id 직접 지정 방식으로 단순화). -->
    <packet name="C_Attack">
        <int name="targetEntityId"/>
    </packet>

    <!-- Phase 06 (M3): Enemy spawn 알림. Codex β 사전 검증 HIGH #1 봉합 — 본 패킷 누락 시 클라가
         target id를 모름(공격 패킷만 박으면 end-to-end 데모 막힘).
         **수신측 동작**: entityId 일치하는 remote enemy entity가 없으면 spawn, 있으면 무시(idempotent).
         **다발 전송 패턴** (Phase 04 S_PlayerJoin 정합): 신규 client EnterGameWorld 시 active enemy roster
         (`GameMap._enemies` 전체)를 다발 전송 → 신규 client는 한 번에 전원 위치 파악.
         entityKind = EnemyKind enum의 byte cast (0=Normal, 1=Boss). 클라 측 디코드 책임. -->
    <packet name="S_EntitySpawn">
        <int name="entityId"/>
        <byte name="entityKind"/>
        <float name="x"/>
        <float name="y"/>
        <int name="currentHp"/>
        <int name="maxHp"/>
    </packet>

    <!-- Phase 06 (M3): Hit 결과 broadcast. Codex β 사전 검증 MEDIUM #3 봉합 — HpUpdate 통합.
         damage text(클라 시각 효과) + HP bar 갱신을 *한 패킷*으로 동시 처리 → broadcast 비용 1배.
         통합 vs 분리 trade-off: 분리는 UI 이벤트 ↔ 상태 갱신 직무 분리지만, 응급은 통합 우선
         (현재 정의는 Phase 06 정의 박힘, 본 마감 분리 검토).
         서버가 전원에게 broadcast (attacker 자기도 포함 — local damage text 렌더 정합). -->
    <packet name="S_HitResult">
        <int name="attackerEntityId"/>
        <int name="targetEntityId"/>
        <int name="damage"/>
        <int name="currentHp"/>
        <int name="maxHp"/>
    </packet>

    <!-- Phase 06 (M3): Entity 사망 broadcast. idempotent 약속 — 서버 `IsDead` flag로 1회만 발사 보장.
         **수신측 동작**: entityId 일치하는 entity despawn (player/enemy 공통). 두 번 받아도 안전.
         Phase 07 보스 사망은 본 패킷 + S_StageClear *별개* 이벤트 (Codex 권장 — 통합 X).
         death broadcast → 클라가 엔티티 제거 → 다음 spawn 패킷 안 옴 (서버 map에서도 제거). -->
    <packet name="S_EntityDeath">
        <int name="entityId"/>
    </packet>

    <!-- Phase 07 (M3): Stage Clear broadcast. 보스(EnemyKind.Boss) HP 0 시점 1회 broadcast.
         서버 `_stageCleared` flag로 중복 방지 (death broadcast와 별 trigger).
         클라 = UI 표시만 (헌법 #1 권위) — 보스 죽음 판정 X, 본 패킷 수신 시점 = stage clear 권위 신호.

         **death (S_EntityDeath, ID 14)와 *별 패킷* 분리 결정** (Codex 권장):
           - S_EntityDeath = entity lifecycle (player/enemy 공통, idempotent despawn)
           - S_StageClear  = game event (보스 한정, UI/씬 전환 trigger)
           직무 분리 + S_EntityDeath.isStageBoss 플래그 통합은 미래 보스 종류 확장 시 폐쇄 패킷화.

         **broadcast 순서**: 같은 tick 안에서 S_EntityDeath → S_StageClear (lifecycle 먼저 / game event 두 번째).
         클라 측은 entity despawn 처리 후 stage clear UI 띄우면 자연스러운 흐름.

         **중복 방지**: 서버 `GameMap._stageCleared` flag로 1회 보장. HP 0 후 추가 attack 도착해도
         (a) target이 이미 _enemies.Remove로 사라져 step 2 silent drop (b) `_stageCleared=true`면 본 broadcast 미진입. -->
    <packet name="S_StageClear">
        <int name="bossEntityId"/>
    </packet>
</PDL>
