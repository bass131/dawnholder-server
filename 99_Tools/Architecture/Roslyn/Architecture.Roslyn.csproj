<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FormatterSdkDirectory>$(MSBuildSDKsPath)/../DotnetTools/dotnet-format</FormatterSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(FormatterSdkDirectory)/*.dll" Exclude="$(FormatterSdkDirectory)/dotnet-format.dll;$(FormatterSdkDirectory)/Microsoft.Build*.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Locator">
      <HintPath>$(FormatterSdkDirectory)/BuildHost-netcore/Microsoft.Build.Locator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(FormatterSdkDirectory)/BuildHost-netcore/**/*">
      <Link>BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RequirePinnedSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(NETCoreSdkVersion)' != '10.0.301'" Text="Architecture requires SDK 10.0.301." />
    <Error Condition="!Exists('$(FormatterSdkDirectory)/Microsoft.CodeAnalysis.Workspaces.MSBuild.dll')" Text="Pinned SDK Workspace DLL is missing." />
  </Target>
</Project>
