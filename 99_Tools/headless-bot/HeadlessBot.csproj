<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 콘솔 도구. 서버와 동일한 net10.0 (Unity 호환 불필요). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 폴더 prefix(99_) 회피 명시 -->
    <RootNamespace>Dawnholder.Tools.HeadlessBot</RootNamespace>
    <AssemblyName>Dawnholder.Tools.HeadlessBot</AssemblyName>
  </PropertyGroup>

  <!-- 헌법 #4 (Shared Code Discipline) + ADR-012 Y2 분리:
       04_ClientNet의 Connector/ClientSession을 클라와 동일 코드로 재사용.
       98_Shared의 Physics.Step, Constants, Protocol 정의도 그대로. -->
  <ItemGroup>
    <ProjectReference Include="..\..\04_ClientNet\Dawnholder.Client.Net.csproj" />
    <ProjectReference Include="..\..\98_Shared\Shared.csproj" />
  </ItemGroup>

  <!-- 맵 terrain 바이너리 파일 — bake 산출물을 출력 Maps/ 폴더로 복사 (D2 배포 경로).
       헌법 #1 정합: 봇은 클라 역할 시뮬레이터이므로 terrain.bin만 실음.
       content.bin (적 스폰/플레이어 스폰 좌표)은 서버 전용 — 봇에 미실음. -->
  <ItemGroup>
    <Content Include="..\..\98_Shared\GameData\Maps\*.terrain.bin">
      <Link>Maps\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
