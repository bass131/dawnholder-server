<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- .NET Standard 2.1의 default C#은 8.0. 최신 문법(file-scoped namespace 등) 쓰려면 명시. -->
    <LangVersion>latest</LangVersion>

    <!-- ADR-010: PDB를 .dll에 embedded + 원본 .cs 통째 임베드 -->
    <!-- → Unity F12 시 원본 코드(주석 포함) 그대로 표시 -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- M4.1 Phase 04: local dirty 방지용 deterministic build.
         EmbedAllSources + DebugType=embedded와 결합 시, 절대 경로/timestamp가
         dll에 임베드 박혀 매 빌드마다 hash 달라짐 → SkipUnchangedFiles 항상 실패 →
         매번 Unity Plugins/Shared.dll 갱신 → git dirty.
         Deterministic + PathMap으로 *같은 환경에서 같은 소스 재빌드 시 같은 hash* 보장.
         주의 (Codex β cross-review 2026-05-23 보강) — *cross-machine* reproducible은 별 가닥.
         deterministic 입력에는 compiler 정확한 버전, 참조 assembly, culture, encoding, analyzer 등 포함되고
         global.json rollForward 정책에 따라 팀원 SDK feature band가 달라지면 hash 깨짐.
         CI 환경 진입 시 ContinuousIntegrationBuild=true 옵션 추가가 정석 (현재 CI 환경 없어 backlog). -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <!-- ADR-010: 빌드 후 산출물(.dll)을 Unity Plugins/로 자동 복사.
       이 한 줄로 헌법 #4(복사-붙여넣기 금지)가 물리적으로 강제됨.
       Unity 측에선 .dll만 보여서 클라가 shared 코드 수정 불가능. -->
  <Target Name="CopyToUnityPlugins" AfterTargets="Build">
    <ItemGroup>
      <_Outputs Include="$(TargetDir)$(TargetName).dll" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\03_Client\Assets\Plugins\Shared\" />
    <Copy SourceFiles="@(_Outputs)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\03_Client\Assets\Plugins\Shared\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
