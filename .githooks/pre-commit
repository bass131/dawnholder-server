#!/usr/bin/env bash
# Shared Git safeguard: preserve each machine's Unity Cloud settings.
# Historical report-template validation lives only on the Claude archive branch.

set -e

# ────────────────────────────────────────────────────────────────────────
# A) ProjectSettings.asset cloud 라인 자동 unstage (각자 Cloud 정책)
#
# 도입: 2026-05-19 — 영호 commit이 유현 cloudProjectId 덮어씀(또는 반대) ping-pong
# 발견. /session:start의 (C-1) 게이트는 *세션 시작 시점*만 작동, 세션 중간 commit은
# 빠져나감. pre-commit 단계에 자동 unstage 박아 *모든 commit*에 강제.
#
# 동작:
#   - cloud 라인 *만* stage → 자동 unstage (워킹 디렉토리는 유지 = 본인 머신 값 보존)
#   - cloud + 다른 변경 함께 → block + 분리 안내
#   - cloud 라인 stage 없음 → noop
# ────────────────────────────────────────────────────────────────────────

PROJ_SETTINGS="03_Client/ProjectSettings/ProjectSettings.asset"
if git diff --cached --name-only 2>/dev/null | grep -qF "$PROJ_SETTINGS"; then
  CLOUD_LINE_CHANGES=$(git diff --cached -U0 -- "$PROJ_SETTINGS" 2>/dev/null \
    | grep -E "^[+-][^+-]" \
    | grep -E "^[+-][[:space:]]*(cloudProjectId|organizationId|projectName|cloudServicesEnabled|Build|Game Performance|Legacy Analytics|Purchasing|UDP|Unity Ads):" \
    || true)

  if [ -n "$CLOUD_LINE_CHANGES" ]; then
    OTHER_CHANGES=$(git diff --cached -U0 -- "$PROJ_SETTINGS" 2>/dev/null \
      | grep -E "^[+-][^+-]" \
      | grep -vE "^[+-][[:space:]]*(cloudProjectId|organizationId|projectName|cloudServicesEnabled|Build|Game Performance|Legacy Analytics|Purchasing|UDP|Unity Ads):" \
      || true)

    if [ -z "$OTHER_CHANGES" ]; then
      echo "🛡️  ProjectSettings.asset cloud 라인만 stage 감지 → 자동 unstage"
      echo "    (각자 Cloud 정책 — cloudProjectId/organizationId 머신마다 다름)"
      git reset HEAD -- "$PROJ_SETTINGS" > /dev/null
      echo "    워킹 디렉토리는 그대로 (본인 머신 Cloud 식별 보존)"
      echo ""

      REMAINING=$(git diff --cached --name-only 2>/dev/null | head -1)
      if [ -z "$REMAINING" ]; then
        echo "❌ pre-commit 차단 — cloud 라인 unstage 후 남은 stage 0건"
        echo "   (cloud 라인만 commit하려는 의도면 commit 자체가 불필요)"
        exit 1
      fi
    else
      # 새 동작 (2026-05-23 봉합): cloud + 다른 변경 함께 stage → cloud hunk만 자동 unstage
      # + 다른 변경은 stage 유지 + commit 진행. 본인 손 `git add -p` 부담 X (학부생 워크플로 정합).
      #
      # 옛 동작 = 차단 + 분리 안내 (본인 손 의무). 사용자가 명시 봉합 요청 (2026-05-23 M3.8 Phase 05).
      # 안전 = cloud 라인 패턴 매칭으로 *알려진 cloud 라인은 unstage*. 잔여 위험 = 알려지지 않은
      # 새 cloud 라인은 commit 박힐 수 있음 (각자 머신 식별 덮어쓸 가능성) → 발견 시 패턴 추가 의무.
      echo "🛡️  ProjectSettings.asset cloud + 다른 변경 함께 stage 감지"
      echo "    → cloud hunk만 자동 unstage, 다른 변경은 commit 진행 (각자 Cloud 정책 정합)"

      CLOUD_HUNKS=$(git diff --cached -- "$PROJ_SETTINGS" 2>/dev/null | awk '
        BEGIN { in_header=1; hunk=""; has_cloud=0 }
        /^diff --git/ { print; in_header=1; next }
        in_header && /^(index|---|\+\+\+)/ { print; next }
        /^@@/ {
          if (hunk != "" && has_cloud) printf "%s", hunk
          hunk = $0 "\n"
          has_cloud = 0
          in_header = 0
          next
        }
        in_header { print; next }
        {
          hunk = hunk $0 "\n"
          if (match($0, /^[+-][ \t]*(cloudProjectId|organizationId|projectName|cloudServicesEnabled|Build|Game Performance|Legacy Analytics|Purchasing|UDP|Unity Ads):/)) {
            has_cloud = 1
          }
        }
        END { if (hunk != "" && has_cloud) printf "%s", hunk }
      ')

      if [ -n "$CLOUD_HUNKS" ]; then
        if echo "$CLOUD_HUNKS" | git apply --cached --reverse - 2>/dev/null; then
          echo "    cloud 라인 unstage 완료 (워킹 디렉토리는 본인 머신 값 유지)"
          echo ""
        else
          # apply 실패 (예: cloud + 다른 변경이 같은 hunk = 거리 가까운 yaml 영역)
          echo "❌ cloud hunk 자동 unstage 실패 — 같은 hunk에 섞여있을 가능성"
          echo "   fallback (본인 손 1회):"
          echo "     git reset HEAD -- $PROJ_SETTINGS"
          echo "     git add -p $PROJ_SETTINGS    # cloud 외 hunk만 'y'로 선택"
          echo "     git commit ..."
          exit 1
        fi
      fi
    fi
  fi
fi

# ────────────────────────────────────────────────────────────────────────
# Goal workflow: no legacy -DONE.md template gate.
exit 0
