{
  "name": "dawnholder-management-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-diagrams.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:typecheck": "tsc --project tsconfig.electron.json --noEmit",
    "desktop:build": "npm run build && tsc --project tsconfig.electron.json",
    "desktop:start": "npm run desktop:build && electron .",
    "mcp:typecheck": "tsc --project tsconfig.mcp.json --noEmit",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:start": "node mcp-dist/mcp/main.js"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
