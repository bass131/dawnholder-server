<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <ProjectReference Include="..\..\98_Shared\Shared.csproj" />
    <ProjectReference Include="..\Network\Dawnholder.Server.Network.csproj" />
  </ItemGroup>

  <!-- ReadAdmission의 migration identity를 실행 권한 확대 없이 배포 원문과 대조한다. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\99_Tools\database\migrations\00*.sql">
      <LogicalName>Persistence.Migrations.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- M4.2 Phase 01: 테스트 어셈블리가 internal 멤버(SpawnNormalEnemy/SpawnBoss) 직접 접근.
       GameMap.SpawnXxx를 internal로 노출한 이유: 테스트 픽스처가 맵 콘텐츠를 직접 구성
       (ex. AttackHandlerTests: HuntingGround + Boss 둘 다 필요) — production API 오염 없이 해결.
       .NET 표준 테스트 패턴 (InternalsVisibleTo). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GameServer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- 맵 바이너리 파일 — bake 산출물을 출력 Maps/ 폴더로 복사 (D2 배포 경로).
       파일 0개여도 빌드 통과 (glob). PreserveNewest = 변경된 파일만 갱신. -->
  <ItemGroup>
    <Content Include="..\..\98_Shared\GameData\Maps\*.bin">
      <Link>Maps\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
