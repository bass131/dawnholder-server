# Dawnholder — 리포 루트 .editorconfig
# 멤버 정렬과 여러 줄 본문의 중괄호를 기존 분석기로 검사한다.
# 정확한 적용 범위와 CI 실패 조건은 CODE_CONVENTION의 현재 자동 검사 설명을 따른다.

root = true

[*.cs]

# StyleCop 카테고리는 비활성화하고 아래 개별 진단만 선택한다.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none

# XML 주석 분석 비활성 진단은 개별로 끈다.
dotnet_diagnostic.SA0001.severity = none

# 개별 진단이 위 category 설정보다 우선한다.
# 멤버 종류: 필드 → 생성자 → 이벤트 → 프로퍼티 → 메서드 → 중첩 타입.
dotnet_diagnostic.SA1201.severity = warning
# 접근성: public → internal → protected internal → protected → private.
dotnet_diagnostic.SA1202.severity = warning

# 여러 줄 본문에 중괄호를 사용하며 한 줄 가드절은 허용한다.
# Directory.Build.props의 EnforceCodeStyleInBuild가 빌드에서 IDE0011을 실행한다.
# Tests와 99_Tools는 하위 .editorconfig로 이 세 규칙을 완화한다.
csharp_prefer_braces = when_multiline
dotnet_diagnostic.IDE0011.severity = warning

# 즉시 피해 처리 파일럿: 이 세 production 파일에서만 CI 빌드 실패 조건으로 적용한다.
[02_Server/GameServer/Maps/{GameMap.cs,Actions/MeleeAction.cs,Actions/DashAction.cs}]
dotnet_diagnostic.SA1201.severity = error
dotnet_diagnostic.SA1202.severity = error
dotnet_diagnostic.IDE0011.severity = error

# .NET SDK 분석기의 복잡도·결합 임계 진단을 이 pilot 범위에서 warning으로 관찰한다.
# CA1502/CA1506은 연속 점수나 전체 아키텍처 평가가 아니다.
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# 서버 패킷 표현 통합: 수정한 추가 production 파일에만 동일한 실패 조건을 적용한다.
[02_Server/GameServer/{Sessions/GameSession.cs,Maps/Transitions/MapMigration.cs,Maps/MapPacketPublisher.cs,Maps/Systems/EnemyAISystem.cs,Maps/Systems/BossBehaviorSystem.cs}]
dotnet_diagnostic.SA1201.severity = error
dotnet_diagnostic.SA1202.severity = error
dotnet_diagnostic.IDE0011.severity = error

[02_Server/**.cs]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[04_ClientNet/**.cs]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[98_Shared/**.cs]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[99_Tools/**.cs]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[99_Tools/PacketGenerator/PacketFormat.cs]
trim_trailing_whitespace = false
