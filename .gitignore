# ─────────────────────────────────────────────
# .NET (server, shared, tools)
# ─────────────────────────────────────────────
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Build output for 98_Shared/ DLL pipeline (ADR-010)
# **/*는 모든 깊이 매칭 — Plugins/Shared/Shared.dll 같이 한 단계 더 들어간 것도 잡음
03_Client/Assets/Plugins/**/*.dll
03_Client/Assets/Plugins/**/*.pdb
03_Client/Assets/Plugins/**/*.dll.meta
03_Client/Assets/Plugins/**/*.pdb.meta

# ─────────────────────────────────────────────
# Unity (client/)
# ─────────────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity 자동 생성 csproj/sln (98_Shared/02_Server csproj는 손으로 관리하므로 제외)
03_Client/*.csproj
03_Client/*.sln
03_Client/*.slnx
03_Client/Assembly-CSharp*.csproj

# Unity 산출물
*.unitypackage
*.apk
*.aab
*.ipa
*.app

# Unity Asset Store package metadata
ExportedObj/
.consulo/
*.svd
*.[Pp]ublish.xml
*.unityproj
*.tmp
*.[Cc]ache
!?*.[Cc]ache/
*.opt

# ─────────────────────────────────────────────
# IDE / Editor
# .vscode는 아래 "VS Code" 섹션에서 화이트리스트 처리 — 이 섹션에서는 제외
# ─────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# JetBrains Rider
*.DotSettings.user

# ─────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Backups / archives (커밋 금지)
# ─────────────────────────────────────────────
*.tar.gz
*.zip
*.bak
*.orig
*.backup

# ─────────────────────────────────────────────
# Secrets / credentials (절대 금지)
# ─────────────────────────────────────────────
*.env
*.env.local
.env*
secrets/
*.pem
*.key
appsettings.Development.json
appsettings.Local.json

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────
# Claude Code (로컬 설정만 무시, 프로젝트 공유 설정은 커밋)
# ─────────────────────────────────────────────
.claude/settings.local.json
.claude/worktrees/
.claude/state/

# ─────────────────────────────────────────────
# 개인 워킹 메모 (각자 보유) — 협업 셋업 파트 1 결정
# 공유 템플릿은 .claude/templates/CONTEXT-{template,History-template}.md 참조
# ─────────────────────────────────────────────
/CONTEXT.md
/CONTEXT_History.md
/CONTEXT_History/

# ─────────────────────────────────────────────
# learning-journal: 사람별 네임스페이스 (각자 폴더는 공유 X)
# 템플릿·README는 공유 (화이트리스트 패턴)
# ─────────────────────────────────────────────
00_Document/learning-journal/*/
!00_Document/learning-journal/_template-*.md
!00_Document/learning-journal/README.md

# ─────────────────────────────────────────────
# VS Code: 협업 최소 셋(extensions + settings)만 화이트리스트, 개인 설정은 무시
# - extensions.json: 권장 확장 목록 (파트 1 결정)
# - settings.json: 통합 터미널 Git Bash 등 협업 최소 셋 (옵션 B 결정 — ADR-020 함정 회피)
# - settings.local.json (있다면): 각자 개인 설정 자유 영역
# ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode/settings.local.json
