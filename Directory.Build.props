<Project>

  <!-- StyleCop.Analyzers: 멤버 정렬(SA1201/SA1202)을 빌드 경고로 강제 — CODE_CONVENTION §7.1. -->
  <!-- 03_Client(Unity)는 03_Client/Directory.Build.props 차단막으로 격리한다: -->
  <!-- Unity는 NuGet PackageReference를 자체 처리하지 않아 끼면 IDE/빌드가 깨진다. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

  <!-- M4.14 P04: .NET IDE 계열 code-style 분석기를 빌드/CI에서 강제 — CODE_CONVENTION §4. -->
  <!-- 없으면 IDE0011(중괄호 when_multiline) 등은 IDE에서만 돌고 빌드/CI엔 안 잡힌다. -->
  <!-- 활성 룰은 .editorconfig severity로 선택 (현재 IDE0011만 warning, 나머지 기본 silent). -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
